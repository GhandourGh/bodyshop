# Groq API (free key from console.groq.com)
GROQ_API_KEY=your_groq_key_here

# HuggingFace (free token from huggingface.co/settings/tokens)
HF_TOKEN=your_hf_token_here

# Roboflow (free key from app.roboflow.com)
ROBOFLOW_API_KEY=your_roboflow_key_here

# App config
APP_ENV=development
LOG_LEVEL=INFO