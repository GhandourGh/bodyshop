# FastAPI AI Microservice — copy to .env and fill in real values

# Groq API key for LLaMA (console.groq.com — free tier available)
GROQ_API_KEY=your_groq_api_key_here

# Neon PostgreSQL connection string (console.neon.tech)
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# HuggingFace token (huggingface.co/settings/tokens)
HF_TOKEN=hf_your_token_here

# API key protecting all 7 AI endpoints — set a strong random string
# Must match VITE_AI_API_KEY in autoforge-frontend/.env
AI_API_KEY=change_me_to_a_secure_random_string

# Comma-separated allowed frontend origins (no trailing slash)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:4173
