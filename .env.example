# =============================================================================
# Repo-root .env — used by the FastAPI AI microservice (main.py).
# Also picked up by intern-db/next.config.mjs as a fallback so AI_API_KEY can
# be defined in one place and shared between FastAPI and Next.js.
#
# Copy to .env and fill in real values. NEVER commit the real .env.
# =============================================================================

# Groq API key for LLaMA customer-message generation (https://console.groq.com)
GROQ_API_KEY=your_groq_api_key_here

# Neon PostgreSQL connection string (https://console.neon.tech)
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# HuggingFace access token, used to load the fine-tuned DistilBERT sentiment
# model (https://huggingface.co/settings/tokens)
HF_TOKEN=hf_your_token_here

# Shared secret protecting every FastAPI AI endpoint. Set a strong random
# string and use the SAME value in:
#   - intern-db/.env       → AI_API_KEY        (server → server)
#   - autoforge-frontend/.env → VITE_AI_API_KEY (browser → FastAPI)
# Leave blank to run FastAPI in open dev mode (no key required).
AI_API_KEY=change_me_to_a_secure_random_string

# Comma-separated allowed frontend origins for CORS (no trailing slash).
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:4173
