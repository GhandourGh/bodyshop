# Frontend (Vite) — copy to .env and fill in real values.
# Anything prefixed with VITE_ is bundled into the client and visible in DevTools,
# so do NOT put secrets here that should remain server-side.

# FastAPI AI microservice base URL (no trailing slash)
VITE_API_URL=http://localhost:8000

# X-API-Key header sent to FastAPI when the AI service has AI_API_KEY set.
# Leave blank when the AI service runs in open dev mode.
# Must match AI_API_KEY in the repo-root .env (for FastAPI) and in intern-db/.env.
VITE_AI_API_KEY=
