# =============================================================================
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.Python
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Virtual environments
venv/
env/
.venv/
.env-py/

# =============================================================================
