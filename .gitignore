# =============================================================================
# Secrets — NEVER commit any .env file with real credentials
# =============================================================================
.env
.env.*
!.env.example
intern-db/.env
intern-db/.env.*
!intern-db/.env.example
autoforge-frontend/.env
autoforge-frontend/.env.*
!autoforge-frontend/.env.example

# Common credential files
*.pem
*.key
*.crt
*.p12
*.pfx
secrets/
credentials.json
service-account*.json

# =============================================================================
