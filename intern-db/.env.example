# =============================================================================
# Next.js backend .env — copy to .env and fill in real values.
# NEVER commit the real .env.
# =============================================================================

# Neon PostgreSQL connection string
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# JWT secret used to sign session tokens. Must be at least 32 characters; use
# a strong random string (e.g. `openssl rand -base64 48`).
JWT_SECRET="change_me_to_a_long_random_string_at_least_32_chars"

# Optional 32-byte base64 key used to AES-256-GCM encrypt the integration
# credential vault. If unset, the system derives a key from JWT_SECRET — fine
# for dev, but set an independent key in production.
# CREDENTIALS_MASTER_KEY=

# How long issued JWT sessions stay valid (e.g. 7d, 24h, 60m)
JWT_EXPIRES_IN="7d"

# How long the user has to enter the TOTP code after a successful password
# step (the short JWT issued between the two steps).
# TOTP_PENDING_EXPIRES_IN=5m

# FastAPI AI microservice base URL (no trailing slash)
AI_SERVICE_URL="http://localhost:8000"

# X-API-Key the Next.js server sends to FastAPI on every AI call. Must match
# AI_API_KEY in the repo-root .env (which FastAPI reads). Server-side only —
# never expose with a VITE_ prefix.
# AI_API_KEY=

# Comma-separated allowed frontend origins for CORS (no trailing slash)
ALLOWED_ORIGINS="http://localhost:5173"

# Public origin used for password-reset links emailed to users
FRONTEND_URL="http://localhost:5173"

# ────────────────────────────────────────────────────────────────────────────
# Email (password reset). All optional — if unset, the reset link is printed
# to the server console instead of being emailed (handy in dev).
# ────────────────────────────────────────────────────────────────────────────
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=you@example.com
# SMTP_PASS=your_smtp_password
# SMTP_FROM="AutoForge <noreply@example.com>"
# SMTP_SECURE=false        # true for port 465
