# Next.js Backend — copy to .env and fill in real values

# Neon PostgreSQL connection string
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# JWT Secret — must be at least 32 characters, use a strong random string
JWT_SECRET="change_me_to_a_long_random_string_at_least_32_chars"

# JWT expiry
JWT_EXPIRES_IN="7d"

# FastAPI AI microservice URL
AI_SERVICE_URL="http://localhost:8000"

# Comma-separated allowed frontend origins for CORS
ALLOWED_ORIGINS="http://localhost:5173"
